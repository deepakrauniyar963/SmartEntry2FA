# Copy this file to ".env" (same folder as the app) and fill in your own values.
# The real .env must NEVER be uploaded to GitHub.

# Gmail account used to send attendance emails + its 16-character App Password
# (Google Account -> Security -> 2-Step Verification -> App passwords)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_16_character_app_password

# Admin password hash. Generate it with:  python set_admin_password.py
ADMIN_PASS_HASH=

# Students arriving after this time (HH:MM:SS, 24h) are marked "Late"
LATE_TIME=09:30:00

# CACHE_HMAC_KEY is generated automatically on first run - no need to set it.
